server {
    listen 80;
    listen [::]:80;
    server_name danaboom.ir www.danaboom.ir;
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name danaboom.ir www.danaboom.ir;

    ssl_certificate /etc/letsencrypt/live/danaboom.ir/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/danaboom.ir/privkey.pem;

    # ----- مدیریت مسیر API (لاراول) -----
    location /api {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ----- مدیریت فایل‌های تصویر (ذخیره‌های لاراول) -----
    location /images/ {
        alias /var/www/gpt/backend/storage/app/public/chat-images/;
        try_files $uri $uri/ =404;
        access_log off;
        expires 30d;
        add_header Cache-Control "public";
    }

    # ----- مدیریت فایل‌های PHP (لاراول) -----
    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/var/run/php/php8.4-fpm.sock;
    }

    # ----- مدیریت بقیه مسیرها (Next.js) -----
    location / {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }
}
